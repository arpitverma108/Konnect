PORT=3000
NODE_ENV=development

# Database (set via environment variables in production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konnect
DB_USER=konnect_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT & Security (MUST set via environment variables in production)
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars
JWT_EXPIRY=24h
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# SVN Configuration
SVN_REPOS_ROOT=/svn/repos
SVNADMIN_PATH=/usr/bin/svnadmin
SVNLOOK_PATH=/usr/bin/svnlook
SVN_PATH=/usr/bin/svn
SVN_BASE_URL=http://localhost/svn

# SVN Auth & Apache
APACHE_RELOAD_CMD=sudo /usr/local/sbin/konnect-apache-reload
SVNAUTHZ_PATH=/usr/bin/svnauthz
AUTHZ_LOCK_DIR=/var/lock/konnect-authz.lock
HTPASSWD_PATH=/etc/apache2/dav_svn.passwd
AUTHZ_PATH=/var/lib/konnect/svn-authz/dav_svn.authz

# Webhooks & Sync (MUST set via environment variables in production)
SYNC_SECRET=your_secure_sync_secret_here_min_32_chars
SYNC_WEBHOOK_URL=http://localhost:3000/api/sync
HOOK_WEBHOOK_URL=http://localhost:3000/api/hooks/svn/post-commit
